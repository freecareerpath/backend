# Postgres connection string. Local dev: point at docker-compose.yml's
# `postgres` service (run `docker compose up postgres` from this directory)
# or any local Postgres 16+. Production: a real managed Postgres instance.
# Read directly by the app — NOT used by docker-compose.yml (see POSTGRES_*
# below for that).
DATABASE_URL=postgresql://fcp:changeme@localhost:5433/freecareerpath

# Port the NestJS server listens on. Defaults to 3000 if unset.
PORT=3000

# --- The four variables below are used only by docker-compose.yml (both
# to configure the `postgres` container and to build the `backend`
# container's own DATABASE_URL) — irrelevant when running `npm run
# start:dev` directly against an existing Postgres via DATABASE_URL above. ---
POSTGRES_USER=fcp
POSTGRES_PASSWORD=
POSTGRES_DB=freecareerpath
POSTGRES_PORT=5433

# Origin allowed to make credentialed (cookie-based) requests — CORS rejects
# everything else (no shared reverse proxy sits in front of both apps; the
# browser talks to web/ and backend/ as two separate origins — see
# docs/development/deployment.md "CORS"). Local dev: the frontend's dev
# server origin, e.g. http://localhost:3100. Production: the frontend's
# real deployed origin, e.g. https://www.freecareerpath.com.
FRONTEND_URL=http://localhost:3100

# Optional, comma-separated — takes precedence over FRONTEND_URL when set.
# Use on Vercel Preview deployments, where the frontend Preview URL changes
# per-deploy and/or you need to allow more than one origin at once, e.g.
# https://freecareerpath.com,https://www.freecareerpath.com
FRONTEND_URLS=

# Cookie SameSite attribute for fcp_access_token/fcp_refresh_token. Leave
# unset (defaults to `lax`) for same-site deployments (production:
# freecareerpath.com + api.freecareerpath.com). Set to `none` only for
# Vercel Preview, where the frontend and backend Preview URLs are on two
# different *.vercel.app subdomains and are therefore cross-site — `none`
# forces Secure=true automatically (browsers require the pairing).
COOKIE_SAMESITE=

# Cookie Domain attribute — leave unset except in real production. Unset
# scopes the cookie to the exact host that issued it (api.freecareerpath.com
# only), which is fine for the browser's own credentialed fetches but means
# web/'s SERVER-SIDE session check (getCurrentUser(), used for the header
# nav, /dashboard, and /freecareerpath-admin's protected layout) can never
# see it, since that check reads cookies from the incoming request to
# web/'s own origin. Set to `.freecareerpath.com` once both apps are on
# real subdomains of that domain, so the cookie is visible to both. Do NOT
# set this on Vercel Preview (*.vercel.app) — vercel.app is a public suffix
# and browsers reject a Domain spanning sibling public-suffix subdomains.
COOKIE_DOMAIN=

# Signs/verifies JWT access tokens (docs/decisions/0004-accounts-and-persistence.md).
# Generate a real random value before ever deploying — e.g. `openssl rand -base64 48`.
# The code falls back to an insecure dev-only default if unset, for local convenience only.
JWT_SECRET=

# Shared secret required in the `x-internal-token` header to accept/reject a milestone
# submission (docs/decisions/0004 "milestone submission honesty" — manual reviewer action).
INTERNAL_REVIEW_TOKEN=

# Seeded by `npm run db:seed` (idempotent — safe to re-run) as the one
# account with the `admin` role, i.e. the only account that can sign in at
# /freecareerpath-admin. Change the password before any real deployment;
# never commit real production credentials here.
ADMIN_EMAIL=admin@freecareerpath.dev
ADMIN_PASSWORD=

# Optional — also seeds a second, non-admin account for testing the regular
# (non-admin) login/session flow. Leave both blank to skip seeding it.
# NEVER set these in production.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- Explain Mode grading (migration 0003) ---
# Grades written explanations against the rubric stored on each node.
# Without a key the /explain/submit route returns 503 and the web app falls
# back to the self-graded checklist, so the site still works unkeyed.
OPENAI_API_KEY=
# Defaults to gpt-5-nano, the cheapest model OpenAI offers
# ($0.05 / $0.40 per million input / output tokens, August 2026).
OPENAI_MODEL=gpt-5-nano
