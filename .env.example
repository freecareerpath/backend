# Postgres connection string (Supabase). Required once an endpoint needs the database — e.g. US-009 email capture.
# Provisioning a Supabase project is a manual step — see docs/architecture.md "Open items".
DATABASE_URL=

# Port the NestJS server listens on. Defaults to 3000 if unset.
PORT=

# v2 (docs/decisions/0004-accounts-and-persistence.md) — auth/progress/milestones/nudges.
# Signs/verifies JWT access tokens. Generate a real random value before ever deploying;
# the code falls back to an insecure dev-only default if unset, for local convenience only.
JWT_SECRET=

# Shared secret required in the `x-internal-token` header to accept/reject a milestone
# submission (docs/decisions/0004 "milestone submission honesty" — manual reviewer action).
INTERNAL_REVIEW_TOKEN=
